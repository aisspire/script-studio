{
  "name": "script-studio",
  "version": "0.1.0",
  "description": "Windows 本地脚本管理器与 Oriel 插件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aisspire/script-studio.git"
  },
  "homepage": "https://github.com/aisspire/script-studio#readme",
  "bugs": "https://github.com/aisspire/script-studio/issues",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test:runtime": "node scripts/check-runtime.mjs",
    "test:commands": "node scripts/check-commands.mjs",
    "test:terminal": "node scripts/check-terminal.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:layout": "node scripts/check-layout.mjs",
    "test:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": { "vue": "3.5.44" },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
